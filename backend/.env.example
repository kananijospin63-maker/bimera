PORT=5000
NODE_ENV=development

# Database URL (PostgreSQL / Supabase Postgres)
DATABASE_URL="postgresql://postgres:password@localhost:5432/bimeradb?schema=public"

# Supabase Auth & Storage Config
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# JWT Secret
JWT_SECRET="super-secret-jwt-key-bimera-2026"
JWT_EXPIRES_IN="7d"

# SMTP Mailer Settings
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="contact@bimera-group.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Bimera Group <noreply@bimera-group.com>"

# Security & CORS
FRONTEND_URL="http://localhost:3000"
